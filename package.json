{
  "name": "open-webpage-on-startup",
  "description": "Automatically open user-defined webpages when your browser starts.",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:all": "bun run --parallel zip zip:firefox",
    "compile": "tsc --noEmit",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "verify": "bun run compile && bun run check",
    "test": "bun test",
    "postinstall": "wxt prepare",
    "manager": "bun manager.cjs bun"
  },
  "dependencies": {
    "@wxt-dev/i18n": "^0.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@wxt-dev/module-svelte": "^2.0.5",
    "bun-types": "^1.4.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "wxt": "^0.21.4"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "spawn-sync"
  ]
}
